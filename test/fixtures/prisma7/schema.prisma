generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  posts     Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  published Boolean  @default(false)
  title     String   @db.VarChar(255)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
  tags      Tag[]
}

model Item {
  id    Int     @id @default(autoincrement())
  value Float
  SKU   String?
  stock Int     @default(0)
}

model Label {
  name  String @unique
  color String
}

model Tag {
  id    Int    @id @default(autoincrement())
  label String
  posts Post[]
}

enum Role {
  USER
  ADMIN
}
